<!DOCTYPE html>
<html lang="en">
  <head>
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="white_favicon_io/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="white_favicon_io/favicon-32x32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="white_favicon_io/favicon-16x16.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="dark_favicon_io/favicon-32x32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="dark_favicon_io/favicon-16x16.png"
      media="(prefers-color-scheme: light)"
    />

    <link
      rel="manifest"
      href="white_favicon_io/site.webmanifest"
      media="(prefers-color-scheme: dark)"
    />

    <link
      rel="manifest"
      href="dark_favicon_io/site.webmanifest"
      media="(prefers-color-scheme: light)"
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="PeakOps Cloud helps businesses reduce cloud costs, deploy faster, and scale securely. Optimize your cloud infrastructure with cost-efficient hosting and automated deployment solutions."
    />
    <meta
      name="keywords"
      content="Cloud Cost Optimization, Reduce Cloud Costs, Optimize Cloud Infrastructure, AWS Cost Management, Cloud Cost Savings"
    />
    <title>
      PeakOps Cloud – Cost Optimization, Scalable Deployment & Enterprise
      Hosting
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: {
                50: "#e3f6f7",
                100: "#c7edf0",
                200: "#a2e0e5",
                300: "#7ed3db",
                400: "#5ac7d1",
                500: "#189ba8", // Main primary color
                600: "#148993",
                700: "#10767f",
                800: "#0b646b",
                900: "#074f57",
              },
              darkbg: {
                700: "#46464a",
                800: "#373643", // Dark background
                900: "#2d2c2e",
              },
            },
          },
        },
      };
    </script>
    <script>
      document.documentElement.classList.add("dark");
    </script>
    <style>
      /* Additional custom styles */
      .dark .input-border-dark {
        border-color: rgba(209, 213, 219, 0.2);
      }

      /* Enhancing input field visibility */
      .form-input {
        border-width: 2px !important;
        outline: none !important;
        border-color: rgba(209, 213, 219, 0.7) !important;
      }

      .dark .form-input {
        border-color: rgba(75, 85, 99, 0.6) !important;
      }

      .form-input:focus {
        border-color: #5d5cde !important;
        box-shadow: 0 0 0 1px rgba(93, 92, 222, 0.2);
      }
    </style>
  </head>
  <body
    class="font-sans antialiased dark:bg-darkbg-900 dark:text-gray-200 min-h-screen flex flex-col"
  >
    <!-- Navigation -->
    <nav class="dark:bg-darkbg-800 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="#" class="flex-shrink-0 flex items-center">
              <img
                src="peakOps-white-logo.svg"
                alt="PeakOps Logo"
                class="h-12 w-12 text-primary-600 mr-2"
              />
            </a>
            <div class="hidden sm:ml-6 sm:flex">
              <a
                href="#services"
                class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
                >Services</a
              >
              <a
                href="#how-it-works"
                class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
                >How It Works</a
              >
              <a
                href="#case-studies"
                class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
                >Case Studies</a
              >
            </div>
          </div>
          <div class="flex items-center">
            <a
              href="#schedule"
              class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 dark:focus:ring-offset-gray-800"
            >
              Schedule Free Audit
            </a>
            <button
              id="mobileMenuButton"
              class="sm:hidden ml-4 inline-flex items-center justify-center p-2 rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 focus:outline-none"
            >
              <i class="fas fa-bars"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobileMenu"
        class="sm:hidden hidden dark:bg-darkbg-800 pb-3 px-4"
      >
        <div class="pt-2 pb-3 space-y-1">
          <a
            href="#services"
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
            >Services</a
          >
          <a
            href="#how-it-works"
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
            >How It Works</a
          >
          <a
            href="#case-studies"
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400"
            >Case Studies</a
          >
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="dark:bg-darkbg-800 pb-8 sm:pb-12">
      <div class="pt-8 overflow-hidden sm:pt-12 lg:relative lg:py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="lg:grid lg:grid-cols-2 lg:gap-8">
            <div class="sm:text-center md:max-w-2xl md:mx-auto lg:text-left">
              <h1
                class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl"
              >
                <span class="block xl:inline">Enterprise Cloud</span>
                <span
                  class="block xl:inline text-primary-600 dark:text-primary-400"
                  >Solutions & Savings</span
                >
              </h1>
              <p
                class="mt-3 text-base text-gray-600 dark:text-gray-300 sm:mt-5 sm:text-xl sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0"
              >
                From cost optimization to complex migrations, we help businesses
                solve their toughest cloud challenges. Get expert DevOps support
                and reduce your cloud bills by up to 50%.
              </p>
              <div class="mt-8 sm:flex sm:justify-center lg:justify-start">
                <div class="rounded-md shadow">
                  <a
                    href="#schedule"
                    class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 md:py-4 md:text-lg md:px-10"
                  >
                    Schedule a Free Consultation
                  </a>
                </div>
                <div class="mt-3 sm:mt-0 sm:ml-3">
                  <a
                    href="#services"
                    class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-primary-700 dark:text-primary-400 bg-primary-100 dark:bg-gray-700 hover:bg-primary-200 dark:hover:bg-gray-600 md:py-4 md:text-lg md:px-10"
                  >
                    Our Services
                  </a>
                </div>
              </div>
            </div>
            <div
              class="mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0"
            >
              <div
                class="relative mx-auto w-full rounded-lg shadow-lg lg:max-w-md"
              >
                <div
                  class="relative block w-full dark:bg-gray-700 rounded-lg overflow-hidden"
                >
                  <div class="p-8">
                    <div class="text-center">
                      <div
                        class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-primary-100 dark:bg-gray-600 text-primary-600 dark:text-primary-400 mb-4"
                      >
                        <i class="fas fa-chart-line text-2xl"></i>
                      </div>
                      <h2
                        class="text-xl font-bold text-gray-900 dark:text-white"
                      >
                        Average Savings
                      </h2>
                      <div
                        class="mt-2 text-4xl font-extrabold text-primary-600 dark:text-primary-400"
                      >
                        35%
                      </div>
                      <p class="mt-2 text-gray-600 dark:text-gray-300">
                        Typical reduction in monthly cloud costs for our clients
                      </p>
                    </div>
                    <div class="mt-8 text-center">
                      <div class="inline-flex gap-4">
                        <!-- Fixed AWS logo -->
                        <div
                          class="flex items-center justify-center h-8 w-12 bg-orange-500 rounded"
                        >
                          <span class="text-white font-bold text-xs">AWS</span>
                        </div>

                        <img
                          src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg"
                          alt="Azure"
                          class="h-8 w-auto"
                        />
                        <img
                          src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg"
                          alt="Google Cloud"
                          class="h-8 w-auto"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Services Section -->
    <section id="services" class="py-12 bg-gray-50 dark:bg-darkbg-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
